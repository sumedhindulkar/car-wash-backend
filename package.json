{
  "name": "car-wash-backend",
  "version": "1.0.0",
  "description": "Backend for a mobile vehicle-service booking application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed:services": "tsx seeds/seed-services.ts",
